# Optional API authentication. Leave blank only on a trusted private network.
TUNESCOUT_API_KEY=
# Docker/Kubernetes secrets can be mounted instead of putting the value in the
# environment. A non-empty direct value takes precedence over its *_FILE form.
# TUNESCOUT_API_KEY_FILE=/run/secrets/tunescout_api_key
TUNESCOUT_LOG_LEVEL=info
TUNESCOUT_MAX_UPLOAD_MB=32
TUNESCOUT_PROVIDER_TIMEOUT=12s
TUNESCOUT_SEARCH_TIMEOUT=25s

# MusicBrainz asks clients to use a meaningful User-Agent.
TUNESCOUT_USER_AGENT=TuneScout/0.1 (+https://github.com/myth815/tunescout)

# Optional providers. Disabled when the corresponding key is blank.
ACOUSTID_API_KEY=
AUDD_API_TOKEN=
JAMENDO_CLIENT_ID=
# ACOUSTID_API_KEY_FILE=/run/secrets/acoustid_api_key
# AUDD_API_TOKEN_FILE=/run/secrets/audd_api_token
# JAMENDO_CLIENT_ID_FILE=/run/secrets/jamendo_client_id
