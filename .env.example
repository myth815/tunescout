# Optional API authentication. Leave blank only on a trusted private network.
TUNESCOUT_API_KEY=
TUNESCOUT_LOG_LEVEL=info
TUNESCOUT_MAX_UPLOAD_MB=32
TUNESCOUT_PROVIDER_TIMEOUT=12s
TUNESCOUT_SEARCH_TIMEOUT=25s

# MusicBrainz asks clients to use a meaningful User-Agent.
TUNESCOUT_USER_AGENT=TuneScout/0.1 (+https://github.com/myth815/tunescout)

# Optional providers. Disabled when the corresponding key is blank.
ACOUSTID_API_KEY=
AUDD_API_TOKEN=
JAMENDO_CLIENT_ID=
